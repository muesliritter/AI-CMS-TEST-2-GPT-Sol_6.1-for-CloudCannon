---
import '@fontsource/dm-serif-display/latin-400.css';
import '@fontsource/dm-serif-display/latin-400-italic.css';
import '@fontsource/dm-sans/latin-400.css';
import '@fontsource/dm-sans/latin-500.css';
import '@fontsource/dm-sans/latin-600.css';
import './style.css';
import settings from './settings.json';
import Place from './Place.astro';
import {getCategories,url,t} from './data';
const {lang='en',category}=Astro.props;
const categories=await getCategories();const c=category?.data;const de=lang==='de';
const active=categories.filter(x=>x.data.status==='active');
const title=c?`${t(c.nav_title,lang)} · ${settings.name}`:settings.name;
const heroPhoto={image:settings.hero_image,alt:settings.hero_image_alt};
const en=url('en',c?.slug), german=url('de',c?.slug);const base=settings.site_url?.replace(/\/$/,'');
---
<!doctype html><html lang={lang}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={c?t(c.intro,lang):t(settings.description,lang)}/><meta name="theme-color" content="#f7f5ef"/><title>{title}</title><link rel="icon" href="/favicon.svg" type="image/svg+xml"/>{base&&<><link rel="canonical" href={`${base}${url(lang,c?.slug)}`}/><link rel="alternate" hreflang="en" href={`${base}${en}`}/><link rel="alternate" hreflang="de" href={`${base}${german}`}/><link rel="alternate" hreflang="x-default" href={`${base}${en}`}/></>}<meta property="og:title" content={title}/><meta property="og:description" content={c?t(c.intro,lang):t(settings.description,lang)}/><meta property="og:type" content="website"/></head>
<body><a class="skip" href="#main">{de?'Zum Inhalt':'Skip to content'}</a>
<header class="header wrap"><a class="brand" href={url(lang)} aria-label="Freiburg for Marlene home"><span class="brand-mark" aria-hidden="true">f<span>m</span></span><span>Freiburg <i>for Marlene</i></span></a><nav aria-label={de?'Hauptnavigation':'Main navigation'}>{categories.map(x=><a aria-current={c?.slug===x.data.slug?'page':undefined} href={url(lang,x.data.slug)}>{t(x.data.nav_title,lang)}</a>)}</nav><div class="languages" aria-label={de?'Sprache':'Language'}><a href={en} lang="en" aria-current={!de?'true':undefined}>EN</a><span>/</span><a href={german} lang="de" aria-current={de?'true':undefined}>DE</a></div></header>
<main id="main" class="wrap">
{!c?<>
<section class="home-hero"><div class="hero-copy"><p class="eyebrow"><span class="tiny-sun">✳</span> {de?'Ein persönlicher Freiburg-Guide':'A personal guide to Freiburg'}</p><h1>{t(settings.home_heading,lang)}<br/>{t(settings.home_heading_line_two,lang)} <em>{t(settings.home_heading_emphasis,lang)}</em></h1><p class="intro">{t(settings.hero,lang)} {t(settings.description,lang)}</p><a class="button" href={url(lang,'cafes')}>{de?'Finde deinen Lieblingsort':'Find your happy place'} <span>↗</span></a><div class="hero-caption"><span class="hand-heart">♡</span><span>{de?'Mit Liebe gesammelt. Für Marlene.':'Collected with love. For Marlene.'}</span></div></div><div class="hero-visual">{heroPhoto?<img src={heroPhoto.image} alt={t(heroPhoto.alt,lang)} width="1000" height="1100" fetchpriority="high"/>:<div class="abstract"><span>Freiburg</span><i>48° N · 7° E</i></div>}<span class="round-note">{de?<>Ein bisschen<br/><i>Freiburg-Liebe</i></>:<>A little bit of<br/><i>Freiburg love</i></>}</span><span class="photo-label">01 — {de?'Eine Stadt zum Bleiben':'A city to linger in'}</span></div></section>
<section class="browse-section" aria-labelledby="browse-title"><div class="section-heading"><div><p class="eyebrow">{de?'Worauf hast du Lust?':'Follow your curiosity'}</p><h2 id="browse-title">{de?'Dein nächster kleiner Umweg.':'Your next little detour.'}</h2></div><p>{de?'Lieblingsorte, handverlesen.':'Good places, personally picked.'}</p></div><div class="category-grid">{categories.map((x,i)=><a class:list={['category-tile',{'soon':x.data.status!=='active'}]} href={url(lang,x.data.slug)}><span class="tile-index">0{i+1}<span aria-hidden="true">{['☕','◒','♧','◇','✳'][i]||'✳'}</span></span><h3>{t(x.data.nav_title,lang)}</h3><div class="tile-bottom"><span>{x.data.status==='active'?`${x.data.sections.length} ${de?'Lieblingsorte':'lovely places'}`:de?'Bald mehr':'Coming soon'}</span><span>↗</span></div></a>)}</div></section>
<section class="personal-note"><span class="note-star" aria-hidden="true">✳</span><div><p class="eyebrow">{de?'Kleine Orte, große Freude':'Small places, big feelings'}</p><h2>{t(settings.note_heading,lang)}</h2><p>{t(settings.note_text,lang)}</p></div></section>
</>:<>
<section class="category-hero"><a class="back-link" href={url(lang)}>← {de?'Der Guide':'The guide'}</a><p class="eyebrow">{t(c.eyebrow,lang)} / {t(c.nav_title,lang)}</p><h1>{t(c.title,lang)}</h1><p class="intro">{t(c.intro,lang)}</p></section>
{c.status==='active'&&<form class="filters" data-filters onsubmit="return false"><div class="filter-first"><label class="search-field"><span aria-hidden="true">⌕</span><input type="search" name="search" placeholder={de?'Lieblingsort suchen …':'Find a little place …'} aria-label={de?'Orte durchsuchen':'Search places'}/></label><label class="sort-label">{de?'Sortieren':'Sort by'}<select name="sort"><option value="curated">{de?'Unsere Reihenfolge':'Curated order'}</option><option value="name">A – Z</option><option value="quarter">{de?'Stadtviertel':'Neighbourhood'}</option>{c.rating_criteria.filter(r=>r.kind==='score').map(r=><option value={`score:${r.id}`}>{t(r.label,lang)} ↓</option>)}</select></label></div><div class="tag-filters"><button type="button" data-all aria-pressed="true">{de?'Alle Orte':'All places'}</button>{c.tags.map(tag=><button type="button" data-tag={tag.id} aria-pressed="false">{t(tag.label,lang)}</button>)}</div><div class="filter-bottom"><p data-count aria-live="polite">{c.sections.length} {de?'Orte zum Entdecken':'places to discover'}</p><button class="clear" type="reset">{de?'Zurücksetzen':'Reset filters'} ↺</button></div></form>}
<div class="place-list" data-place-list>{c.sections.map((p,index)=><Place place={p} category={c} lang={lang} index={index}/>)}</div><p class="no-results" hidden data-empty>{de?'Noch kein Treffer. Versuche einen anderen Filter.':'No little places found. Try another filter.'}</p>
{c.status==='coming-soon'&&<p class="placeholder-explanation">{de?'Beispieleintrag · Dieses Kapitel wird bald mit echten Empfehlungen gefüllt.':'Example entry · This chapter will be filled with real recommendations soon.'}</p>}
<a class="back-top" href="#main">{de?'Zurück nach oben':'Back to the top'} ↑</a>
</>}
</main><footer class="footer wrap"><div class="footer-top"><a class="brand" href={url(lang)}>Freiburg <i>for Marlene</i></a><p>{de?'Mehr kleine Glücksmomente folgen.':'More little discoveries to come.'} ♡</p></div><div class="footer-bottom"><p>{t(settings.note,lang)}</p><span>Freiburg im Breisgau · {new Date().getFullYear()}</span></div></footer>
<dialog class="lightbox" data-lightbox><button type="button" class="close-lightbox" autofocus aria-label={de?'Schließen':'Close'}>×</button><button type="button" class="prev-photo" aria-label={de?'Vorheriges Foto':'Previous photo'}>←</button><figure><img src="" alt=""/><figcaption></figcaption></figure><button type="button" class="next-photo" aria-label={de?'Nächstes Foto':'Next photo'}>→</button></dialog>
<script>import './interactions';</script>
</body></html>
