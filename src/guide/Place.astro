---
import {t} from './data';
const {place:p,category:c,lang,index}=Astro.props;
const photos=p.gallery.filter((x:any)=>x.publish);
const score=p.ratings.find((r:any)=>r.criterion===c.rating_criteria.find((r:any)=>r.kind==='score')?.id)?.score;
const criteria=c.rating_criteria;
---
<article class:list={['place',{'is-placeholder':p.placeholder}]} id={p.id} data-place data-name={p.name} data-quarter={t(p.quarter,lang)} data-tags={JSON.stringify(p.tags)} data-score={score??-1} data-ratings={JSON.stringify(Object.fromEntries(p.ratings.map((r:any)=>[r.criterion,r.score])))} data-order={index}>
 <div class="place-copy">
  <div class="place-top"><span class="eyebrow">{String(index+1).padStart(2,'0')} / {t(p.quarter,lang)}</span>{score!=null&&<span class="score" title={lang==='de'?'Persönliche Bewertung':'Personal score'}><span aria-hidden="true">✦</span> {new Intl.NumberFormat(lang,{minimumFractionDigits:1}).format(score)} <small>/ {criteria.find((r:any)=>r.kind==='score')?.maximum??5}</small></span>}</div>
  <h2>{p.name}</h2><p class="specialty">{t(p.specialty,lang)}</p>
  <div class="tags">{p.tags.map((id:string)=><span>{t(c.tags.find((x:any)=>x.id===id)?.label,lang)||id}</span>)}</div>
  <dl>{criteria.map((crit:any)=>{const r=p.ratings.find((x:any)=>x.criterion===crit.id);return r&&(t(r.text,lang)||r.score!=null)&&<div><dt>{t(crit.label,lang)}</dt><dd>{crit.kind==='score'&&r.score!=null?`${new Intl.NumberFormat(lang).format(r.score)} / ${crit.maximum}`:t(r.text,lang)}</dd></div>})}</dl>
  <div class="place-links">{p.maps&&<a class="text-link" href={p.maps} target="_blank" rel="noopener noreferrer">{lang==='de'?'Auf der Karte':'Find on Maps'} ↗</a>}{p.website&&<a class="muted-link" href={p.website} target="_blank" rel="noopener noreferrer">{p.website.includes('instagram.com')?'Instagram':'Website'} ↗</a>}</div>
 </div>
 <div class="gallery-area">
 {photos.length ? <><div class="gallery" data-gallery>{photos.map((photo:any,i:number)=><button type="button" class:list={['gallery-tile',{'gallery-main':i===0}]} data-photo={photo.image} data-alt={t(photo.alt,lang)} aria-label={`${lang==='de'?'Foto öffnen':'Open photo'}: ${t(photo.alt,lang)}`}><img src={photo.image} alt={t(photo.alt,lang)} loading="lazy" width="900" height="700"/><span aria-hidden="true">↗</span></button>)}</div><details class="credits"><summary>{lang==='de'?'Bildquellen':'Photo credits'} · {photos.length}</summary>{photos.map((photo:any)=><p><a href={photo.source_url} target="_blank" rel="noopener noreferrer">{photo.credit}</a>{photo.rights_status==='unverified'&&<small> · {lang==='de'?'Nutzungsrechte ungeklärt':'Usage rights unverified'}</small>}</p>)}</details></> : <div class="photo-empty"><span aria-hidden="true">✳</span><p>{p.placeholder?(lang==='de'?'Platz für neue Perspektiven':'Room for new perspectives'):(lang==='de'?'Ein erster Eindruck kommt bald':'A first glimpse, coming soon')}</p><small>{lang==='de'?'Bildergalerie':'Photo journal'}</small></div>}
 </div>
</article>
